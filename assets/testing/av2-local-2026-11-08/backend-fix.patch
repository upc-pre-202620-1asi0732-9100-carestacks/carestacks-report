@@ -0,0 +1,100 @@
+package com.carestacks.careconnect;
+
+import com.carestacks.careconnect.iam.application.abstractions.AuthService;
+import com.carestacks.careconnect.iam.application.iam.requests.RegisterUserRequest;
+import com.carestacks.careconnect.iam.domain.iam.enums.UserRole;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.core.env.Environment;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.util.UUID;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.springframework.boot.test.context.SpringBootTest.WebEnvironment.RANDOM_PORT;
+
+@SpringBootTest(webEnvironment = RANDOM_PORT)
+class SecurityBoundariesIntegrationTests {
+    private final HttpClient client = HttpClient.newHttpClient();
+    @Value("${local.server.port}") private int port;
+    @Autowired private AuthService auth;
+    @Autowired private Environment environment;
+
+    @Test
+    void trustedFrontendCanPreflightAuthorizedRequests() throws Exception {
+        var response = preflight("https://carestacks-web.onrender.com");
+        assertEquals(200, response.statusCode());
+        assertEquals("https://carestacks-web.onrender.com",
+                response.headers().firstValue("Access-Control-Allow-Origin").orElse(""));
+    }
+
+    @Test
+    void arbitraryOriginCannotPreflight() throws Exception {
+        var response = preflight("https://untrusted.example");
+        assertEquals(403, response.statusCode());
+        assertTrue(response.headers().firstValue("Access-Control-Allow-Origin").isEmpty());
+    }
+
+    @Test
+    void h2ConsoleIsDisabledByDefault() {
+        assertFalse(environment.getProperty("spring.h2.console.enabled", Boolean.class, false));
+    }
+
+    @Test
+    void diaryRequiresAnIssuedSession() throws Exception {
+        assertEquals(401, get("/api/diary/patient/" + UUID.randomUUID(), null).statusCode());
+    }
+
+    @Test
+    void fabricatedBearerDoesNotAuthenticate() throws Exception {
+        assertEquals(401, get("/api/diary/patient/" + UUID.randomUUID(), "fabricated-session").statusCode());
+    }
+
+    @Test
+    void issuedSessionWorksAndLogoutRevokesItAtTheFilter() throws Exception {
+        var request = new RegisterUserRequest();
+        request.setEmail("security-" + UUID.randomUUID() + "@example.test");
+        request.setPassword("TestPass123");
+        request.setFullName("Security test user");
+        request.setRole(UserRole.PATIENT);
+        var session = auth.register(request);
+        var patientId = auth.getUserIdFromToken(session.token());
+        var endpoint = "/api/diary/patient/" + patientId;
+        assertEquals(200, get(endpoint, session.token()).statusCode());
+        auth.logout(session.token());
+        assertEquals(401, get(endpoint, session.token()).statusCode());
+    }
+
+    @Test
+    void evenAnUnmappedApiRouteRequiresAuthentication() throws Exception {
+        assertEquals(401, get("/api/future-private-resource", null).statusCode());
+    }
+
+    @Test
+    void internalMetricsAreNotAnonymous() throws Exception {
+        assertEquals(401, get("/actuator/metrics", null).statusCode());
+    }
+
+    @Test
+    void apiDocumentationRemainsPublic() throws Exception {
+        assertEquals(200, get("/v3/api-docs", null).statusCode());
+    }
+
+    private HttpResponse<String> get(String route, String token) throws Exception {
+        var request = HttpRequest.newBuilder(URI.create("http://localhost:" + port + route));
+        if (token != null) request.header("Authorization", "Bearer " + token);
+        return client.send(request.GET().build(), HttpResponse.BodyHandlers.ofString());
+    }
+
+    private HttpResponse<String> preflight(String origin) throws Exception {
+        return client.send(HttpRequest.newBuilder(URI.create("http://localhost:" + port + "/api/agenda"))
+                .header("Origin", origin)
+                .header("Access-Control-Request-Method", "PATCH")
+                .header("Access-Control-Request-Headers", "authorization,content-type")
+                .method("OPTIONS", HttpRequest.BodyPublishers.noBody()).build(),
+                HttpResponse.BodyHandlers.ofString());
+    }
+}
